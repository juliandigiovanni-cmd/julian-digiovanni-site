---
/**
 * A build-time chart with its caption and source line.
 *
 * `svg` is markup produced by src/lib/chart.ts, so it is ours rather than
 * user input. The caption and source line sit behind a "Notes and sources"
 * disclosure, collapsed by default like the abstracts on the Research page, so
 * they can be set at a readable size without crowding the chart. The source
 * line names the data and its licence, which is not optional for the CC BY
 * series -- it stays in the page, one click away.
 */
interface Props {
  svg: string;
  caption: string;
  source: string;
}
const { svg, caption, source } = Astro.props;
---

<figure class="figure">
  <div class="figure__plot" set:html={svg} />
  <figcaption>
    <details class="figure__notes">
      <summary>Notes and sources</summary>
      <p>{caption}</p>
      <p class="figure__src">{source}</p>
    </details>
  </figcaption>
</figure>
